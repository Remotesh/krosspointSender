    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/turndown": "^5.0.6",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
